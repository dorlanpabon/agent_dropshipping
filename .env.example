# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Shopify Configuration
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Domain Provider (e.g., GoDaddy, Namecheap)
DOMAIN_PROVIDER_API_KEY=your_domain_provider_api_key
DOMAIN_PROVIDER_API_SECRET=your_domain_provider_api_secret

# Dropi Configuration
DROPI_API_KEY=your_dropi_api_key

# Marketing Platforms
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_AD_ACCOUNT_ID=your_facebook_ad_account_id
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_AD_ACCOUNT_ID=your_tiktok_ad_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Agent Configuration
AGENT_MODE=autonomous # or 'supervised'
AGENT_CHECK_INTERVAL_MINUTES=60
AUTO_APPROVE_PURCHASES=false
MAX_DAILY_AD_SPEND=100
